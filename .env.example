# Server only. Never prefix secrets with VITE_.
MONGODB_URI=mongodb://127.0.0.1:27017/rowready
PORT=3000
NODE_ENV=development
# Use 1 only behind one trusted reverse proxy, e.g. Render. Locally use 0.
TRUST_PROXY=0
# Optional dedicated MongoDB database for integration tests. Tests delete their own reports.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/rowready_test
